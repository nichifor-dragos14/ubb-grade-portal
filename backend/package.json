{
  "name": "backend",
  "version": "0.0.0",
  "scripts": {
    "install": "dotnet restore ./UBBGradePortal.sln && dotnet tool restore",
    "create-migration": "echo 'Enter Migration Name:' && read message && dotnet ef migrations add \"$message\" -s=./UBBGradePortal.WebApi --project=./UBBGradePortal.Infrastructure",
    "build": "dotnet publish ./UBBGradePortal.WebApi/UBBGradePortal.WebApi.csproj -o dist",
    "clean": "dotnet clean ./UBBGradePortal.sln && rm -rf dist",
    "start": "dotnet watch --project ./UBBGradePortal.WebApi/UBBGradePortal.WebApi.csproj",
    "format": "dotnet format ./UBBGradePortal.sln"
  },
  "dependencies": {
    "prettier": "^3.1.1"
  },
  "private": true
}
